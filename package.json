{
  "name": "evat-app-be",
  "version": "1.0.0",
  "description": "The EVAT Backend is a server-side application supporting the Electric Vehicle Adoption Tool (EVAT). Built with Node.js, Express.js, and MongoDB,",
  "main": "server.ts",
  "scripts": {
    "server": "ts-node-dev server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "start": "node dist/server.js",
    "test:ci": "jest -c jest.ci.config.js --coverage --ci",
    "test:unit": "jest -c jest.ci.config.js --selectProjects unit --ci",
    "test:integration": "jest -c jest.ci.config.js --selectProjects integration --ci",
    "audit:prod": "npm audit --omit=dev"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/long": "^5.0.0",
    "@types/mongodb": "^4.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^17.0.10",
    "@types/node-fetch": "^2.6.12",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.3.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@googlemaps/places": "^2.0.1",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^14.3.2",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "long": "^5.3.2",
    "mongoose": "^6.1.7",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.10",
    "prom-client": "^15.1.3",
    "recharts": "^3.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2"
  }
}
